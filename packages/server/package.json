{
  "name": "@easycode/server",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCode 的 Fastify 服务：把 Core 暴露为 HTTP + SSE 接口",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test dist/app.test.js dist/prompt-profiles.test.js dist/model-configs.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@easycode/core": "*",
    "@easycode/protocol": "*",
    "@easycode/schema": "*",
    "@fastify/cors": "^11.4.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.1"
  }
}
